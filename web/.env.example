# Identity provider, matching the API's AUTH_PROVIDER:
# "dev" (default) signs in with dev:<name> tokens, accepted by the API with AUTH_PROVIDER=dev.
# "internal" signs in with email and password in the app itself.
# "oidc" uses Zitadel (fill in VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID).
VITE_AUTH_PROVIDER=dev
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
