# Provedor de identidade, igual ao AUTH_PROVIDER da API:
# "dev" (padrão) entra com tokens dev:<nome>, aceitos pela API com AUTH_PROVIDER=dev.
# "internal" entra com e-mail e senha no próprio app.
# "oidc" usa o Zitadel (preencha VITE_OIDC_ISSUER e VITE_OIDC_CLIENT_ID).
VITE_AUTH_PROVIDER=dev
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
